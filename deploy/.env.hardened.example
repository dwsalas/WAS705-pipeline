# Firefly recognises its HTTPS context behind the nginx proxy:
APP_URL=https://172.16.24.73
TRUSTED_PROXIES=**
APP_ENV=production
APP_DEBUG=false
APP_KEY=CHANGE_ME_32_CHARACTERS_LONG____
SITE_OWNER=you@example.com
DEFAULT_LANGUAGE=en_US
TZ=America/Toronto

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# token in the cron container URL (any long random string):
CRON_TOKEN=CHANGE_ME_CRON_TOKEN
